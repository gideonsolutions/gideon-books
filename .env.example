# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL 14+ connection string.
DATABASE_URL=postgres://books:books@localhost:54329/books
# The address people use to reach this server (links in emails, cookie security).
APP_URL=http://localhost:3200
# At least 32 random characters. Encrypts provider secrets and two-step seeds at rest.
# Generate with: openssl rand -base64 48
BOOKS_ENCRYPTION_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# ── Sign-up ──────────────────────────────────────────────────────────────────
# open: anyone can create an account. invite_only: only the first account (the
# instance administrator); everyone else joins through an invitation.
SIGNUP_MODE=open

# ── Email (password resets, invoices, statements) ────────────────────────────
# outbox: nothing is sent; messages are kept and shown as not delivered.
# smtp | resend: real delivery.
EMAIL_PROVIDER=outbox
EMAIL_FROM="Gideon Books <books@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# RESEND_API_KEY=

# ── Attachments ──────────────────────────────────────────────────────────────
# fs (a directory) or s3 (any S3-compatible store).
STORAGE_DRIVER=fs
STORAGE_DIR=./storage
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_BYTES=20971520

# ── Exchange rates ───────────────────────────────────────────────────────────
# ecb (European Central Bank reference rates, no key) or none (manual only).
FX_PROVIDER=ecb

# ── Hosted offering (leave unset when self-hosting) ──────────────────────────
# HOSTED_MODE=true enables plans, usage limits and billing. See docs/hosted.md.
# HOSTED_MODE=false

# ── Operations ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Behind a reverse proxy that sets X-Forwarded-For (default true).
TRUST_PROXY=true
DATABASE_POOL_MAX=10
